{
  "name": "@repo/types",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./company": {
      "types": "./src/company.ts",
      "default": "./src/company.ts"
    },
    "./employee": {
      "types": "./src/employee.ts",
      "default": "./src/employee.ts"
    },
    "./payroll": {
      "types": "./src/payroll.ts",
      "default": "./src/payroll.ts"
    }
  },
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc --noEmit",
    "check-types": "tsc --noEmit",
    "lint": "echo \"No lint configured for @repo/types\"",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "typescript": "5.9.2"
  }
}
