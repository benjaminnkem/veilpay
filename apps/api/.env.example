NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
WEB_URL=http://localhost:3000

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=veilpay
DB_PASSWORD=veilpay
DB_DATABASE=veilpay
DB_SYNC=true
DB_LOGGING=false

JWT_ACCESS_SECRET=veilpay-dev-access-secret-change-me
JWT_REFRESH_SECRET=veilpay-dev-refresh-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

APP_NAME=VeilPay
INVITATION_EXPIRY_DAYS=7

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM=

# Safe execution (server-side signer must be a Safe owner)
# For Sepolia testing use a 1-of-1 Safe owner private key
BLOCKCHAIN_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
SAFE_OWNER_PRIVATE_KEY=
# Optional: Safe Transaction Service API key for multi-sig proposals
SAFE_API_KEY=

# Nox confidential payroll (Ethereum Sepolia)
# SAFE_OWNER_PRIVATE_KEY signs Safe wrap + owner EOA confidentialTransfer
# Optional override (defaults to SAFE_OWNER_PRIVATE_KEY)
NOX_PAYER_PRIVATE_KEY=
# Deployed ERC-20→ERC-7984 wrapper (wcUSDC); can also be set only in org UI
NOX_CTOKEN_ADDRESS=
