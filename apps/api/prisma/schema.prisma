generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum MemberRole {
  OWNER
  ADMIN
  HR
  FINANCE
  EMPLOYEE
}

enum MemberStatus {
  ACTIVE
  INACTIVE
}

enum CompanyStatus {
  SAFE_NOT_CONFIGURED
  ACTIVE
  SUSPENDED
}

enum SafeStatus {
  PREDICTED
  DEPLOYED
  VERIFIED
  FAILED
}

enum IntentStatus {
  CREATED
  AWAITING_USER_SIGNATURE
  SUBMITTED
  CONFIRMED
  VERIFIED
  EXPIRED
  FAILED
  REPLACED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum EmploymentStatus {
  INVITED
  ACTIVE
  INACTIVE
  TERMINATED
}

enum PayFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum PayrollStatus {
  DRAFT
  PREPARING
  PREPARED
  PROPOSING
  PROPOSED
  SAFE_APPROVED
  EXECUTING
  EXECUTED
  CANCELLED
  EXPIRED
  SAFE_REJECTED
  FAILED_RETRYABLE
  FAILED_FINAL
}

enum PayrollItemStatus {
  SNAPSHOTTED
  PREPARED
  SUBMITTED
  CONFIRMED
  FAILED
}

enum ProposalStatus {
  CREATED
  PROPOSED
  CONFIRMED
  EXECUTED
  REJECTED
  FAILED
}

enum ChainTxStatus {
  CREATED
  SUBMITTED
  MINED
  FINALIZED
  REVERTED
  DROPPED
  REPLACED
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  DEAD
}

enum FundingStatus {
  CREATED
  SUBMITTED
  VERIFIED
  FAILED
}

model User {
  id                 String               @id @default(uuid()) @db.Uuid
  email              String
  emailNormalized    String               @unique
  passwordHash       String
  name               String
  organizationName   String?
  status             UserStatus           @default(PENDING)
  emailVerifiedAt    DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  sessions           Session[]
  wallets            Wallet[]
  walletChallenges   WalletChallenge[]
  memberships        CompanyMember[]
  invitationsCreated EmployeeInvitation[] @relation("InvitationCreator")
  employeeProfiles   EmployeeProfile[]
  payrollsCreated    PayrollRun[]         @relation("PayrollCreator")
  auditLogs          AuditLog[]
}

model Session {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  tokenHash    String    @unique
  familyId     String    @db.Uuid
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.Uuid
  userAgent    String?
  ipAddress    String?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
}

model OneTimeToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  purpose   String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, purpose])
}

model Wallet {
  id                String                 @id @default(uuid()) @db.Uuid
  userId            String                 @db.Uuid
  address           String                 @unique @db.VarChar(42)
  chainType         String                 @default("EVM")
  verifiedAt        DateTime
  isPrimary         Boolean                @default(false)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeProfiles  EmployeeProfile[]
  deploymentIntents SafeDeploymentIntent[]

  @@index([userId, isPrimary])
}

model WalletChallenge {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  nonceHash String    @unique
  message   String
  address   String    @db.VarChar(42)
  domain    String
  uri       String
  chainId   BigInt
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Company {
  id                     String                  @id @default(uuid()) @db.Uuid
  name                   String
  slug                   String                  @unique
  status                 CompanyStatus           @default(SAFE_NOT_CONFIGURED)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  members                CompanyMember[]
  safeAccounts           SafeAccount[]
  invitations            EmployeeInvitation[]
  employees              EmployeeProfile[]
  payrollRuns            PayrollRun[]
  fundingIntents         FundingIntent[]
  deploymentIntents      SafeDeploymentIntent[]
  idempotencyKeys        IdempotencyKey[]
  auditLogs              AuditLog[]
  blockchainTransactions BlockchainTransaction[]

  @@index([status, createdAt])
}

model CompanyMember {
  id              String           @id @default(uuid()) @db.Uuid
  companyId       String           @db.Uuid
  userId          String           @db.Uuid
  role            MemberRole
  status          MemberStatus     @default(ACTIVE)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeProfile EmployeeProfile?

  @@unique([companyId, userId])
  @@index([companyId, role, status])
}

model SafeAccount {
  id                String                 @id @default(uuid()) @db.Uuid
  companyId         String                 @db.Uuid
  chainId           BigInt
  address           String?                @db.VarChar(42)
  predictedAddress  String                 @db.VarChar(42)
  threshold         Int                    @default(1)
  status            SafeStatus             @default(PREDICTED)
  deploymentTxHash  String?                @db.VarChar(66)
  deployedAt        DateTime?
  lastSyncedAt      DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  company           Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deploymentIntents SafeDeploymentIntent[]
  payrollRuns       PayrollRun[]

  @@unique([companyId, chainId])
  @@unique([chainId, address])
}

model SafeDeploymentIntent {
  id               String       @id @default(uuid()) @db.Uuid
  companyId        String       @db.Uuid
  safeAccountId    String       @db.Uuid
  walletId         String       @db.Uuid
  chainId          BigInt
  to               String       @db.VarChar(42)
  value            String
  data             String
  predictedAddress String       @db.VarChar(42)
  saltNonce        String
  status           IntentStatus @default(AWAITING_USER_SIGNATURE)
  txHash           String?      @db.VarChar(66)
  expiresAt        DateTime
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  company          Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  safeAccount      SafeAccount  @relation(fields: [safeAccountId], references: [id], onDelete: Cascade)
  wallet           Wallet       @relation(fields: [walletId], references: [id])

  @@index([companyId, status])
}

model FundingIntent {
  id              String        @id @default(uuid()) @db.Uuid
  companyId       String        @db.Uuid
  chainId         BigInt
  to              String        @db.VarChar(42)
  value           String
  data            String
  amountBaseUnits String
  status          FundingStatus @default(CREATED)
  txHash          String?       @db.VarChar(66)
  balanceHandle   String?
  expiresAt       DateTime
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
}

model EmployeeInvitation {
  id              String           @id @default(uuid()) @db.Uuid
  companyId       String           @db.Uuid
  inviterUserId   String           @db.Uuid
  email           String
  emailNormalized String
  displayName     String
  tokenHash       String           @unique
  role            MemberRole       @default(EMPLOYEE)
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  status          InvitationStatus @default(PENDING)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  inviter         User             @relation("InvitationCreator", fields: [inviterUserId], references: [id])

  @@index([companyId, status, createdAt])
  @@index([emailNormalized, status])
}

model EmployeeProfile {
  id                 String           @id @default(uuid()) @db.Uuid
  companyId          String           @db.Uuid
  userId             String           @db.Uuid
  companyMemberId    String           @unique @db.Uuid
  walletId           String?          @db.Uuid
  displayName        String
  email              String
  employmentStatus   EmploymentStatus @default(INVITED)
  salaryCiphertext   Bytes?
  salaryCurrency     String           @default("ctUSDC")
  salaryTokenAddress String?          @db.VarChar(42)
  payFrequency       PayFrequency     @default(MONTHLY)
  startDate          DateTime?
  endDate            DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  company            Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyMember      CompanyMember    @relation(fields: [companyMemberId], references: [id], onDelete: Cascade)
  wallet             Wallet?          @relation(fields: [walletId], references: [id])
  payrollItems       PayrollItem[]

  @@unique([companyId, userId])
  @@index([companyId, employmentStatus, createdAt])
}

model PayrollRun {
  id                     String                   @id @default(uuid()) @db.Uuid
  companyId              String                   @db.Uuid
  safeAccountId          String                   @db.Uuid
  chainId                BigInt
  tokenAddress           String                   @db.VarChar(42)
  payrollContractAddress String                   @db.VarChar(42)
  label                  String
  onchainPayrollId       String                   @unique @db.VarChar(66)
  manifestVersion        Int                      @default(1)
  manifestHash           String?                  @db.VarChar(66)
  status                 PayrollStatus            @default(DRAFT)
  itemCount              Int                      @default(0)
  deadline               DateTime?
  safeTxHash             String?                  @db.VarChar(66)
  safeExecutionTxHash    String?                  @db.VarChar(66)
  executionTxHash        String?                  @db.VarChar(66)
  preparedAt             DateTime?
  proposedAt             DateTime?
  safeApprovedAt         DateTime?
  executedAt             DateTime?
  cancelledAt            DateTime?
  version                Int                      @default(0)
  createdById            String                   @db.Uuid
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  company                Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  safeAccount            SafeAccount              @relation(fields: [safeAccountId], references: [id])
  createdBy              User                     @relation("PayrollCreator", fields: [createdById], references: [id])
  items                  PayrollItem[]
  proposal               SafeTransactionProposal?

  @@index([companyId, status, createdAt])
}

model PayrollItem {
  id                       String            @id @default(uuid()) @db.Uuid
  payrollRunId             String            @db.Uuid
  employeeProfileId        String            @db.Uuid
  itemIndex                Int
  recipientAddress         String            @db.VarChar(42)
  salaryCiphertextSnapshot Bytes
  encryptedHandle          String?
  inputProof               Bytes?
  handleHash               String?           @db.VarChar(66)
  transferResultHandle     String?
  status                   PayrollItemStatus @default(SNAPSHOTTED)
  txHash                   String?           @db.VarChar(66)
  blockNumber              BigInt?
  logIndex                 Int?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  payrollRun               PayrollRun        @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employeeProfile          EmployeeProfile   @relation(fields: [employeeProfileId], references: [id])

  @@unique([payrollRunId, itemIndex])
  @@unique([payrollRunId, recipientAddress])
  @@index([employeeProfileId, status])
}

model SafeTransactionProposal {
  id                    String         @id @default(uuid()) @db.Uuid
  payrollRunId          String         @unique @db.Uuid
  safeAddress           String         @db.VarChar(42)
  safeTxHash            String         @unique @db.VarChar(66)
  transactionJson       Json
  senderAddress         String?        @db.VarChar(42)
  senderSignature       String?
  status                ProposalStatus @default(CREATED)
  confirmationsRequired Int            @default(1)
  confirmationsReceived Int            @default(0)
  onchainTxHash         String?        @db.VarChar(66)
  lastSyncedAt          DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  payrollRun            PayrollRun     @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
}

model BlockchainTransaction {
  id              String        @id @default(uuid()) @db.Uuid
  companyId       String        @db.Uuid
  relatedType     String
  relatedId       String
  chainId         BigInt
  txHash          String        @db.VarChar(66)
  fromAddress     String?       @db.VarChar(42)
  toAddress       String?       @db.VarChar(42)
  functionName    String
  status          ChainTxStatus @default(SUBMITTED)
  blockNumber     BigInt?
  blockHash       String?       @db.VarChar(66)
  confirmations   Int           @default(0)
  failureCategory String?
  sanitizedReason String?
  submittedAt     DateTime      @default(now())
  minedAt         DateTime?
  finalizedAt     DateTime?
  updatedAt       DateTime      @updatedAt
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([chainId, txHash])
  @@index([companyId, status, submittedAt])
}

model IdempotencyKey {
  id             String   @id @default(uuid()) @db.Uuid
  companyId      String?  @db.Uuid
  userId         String   @db.Uuid
  key            String
  operation      String
  requestHash    String
  responseStatus Int?
  responseBody   Json?
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  company        Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, operation, key])
  @@index([expiresAt])
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorUserId  String?  @db.Uuid
  companyId    String?  @db.Uuid
  action       String
  resourceType String
  resourceId   String?
  metadata     Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
  actor        User?    @relation(fields: [actorUserId], references: [id])
  company      Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
}

model DurableJob {
  id          String    @id @default(uuid()) @db.Uuid
  type        String
  payload     Json
  status      JobStatus @default(PENDING)
  attempts    Int       @default(0)
  maxAttempts Int       @default(8)
  runAt       DateTime  @default(now())
  lockedAt    DateTime?
  lockedBy    String?
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, runAt])
}
