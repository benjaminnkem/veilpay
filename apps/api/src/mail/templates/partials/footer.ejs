<div class="footer">
  <p style="margin: 0 0 6px; color: inherit; font-size: 12px;">
    © <%= year %> <%= appName %>. Built for confidential payroll operations.
  </p>
  <p style="margin: 0; color: inherit; font-size: 12px;">
    <% if (typeof webUrl !== 'undefined' && webUrl) { %>
      <a href="<%= webUrl %>"><%= webUrl.replace(/^https?:\/\//, '') %></a>
    <% } else { %>
      This message was sent by <%= appName %>.
    <% } %>
  </p>
  <p style="margin: 10px 0 0; color: inherit; font-size: 11px;">
    If you were not expecting this email, you can ignore it safely.
  </p>
</div>
