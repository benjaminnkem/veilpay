/* Progressive enhancement only. Core look is inline on each element. */
@media (prefers-color-scheme: dark) {
  .email-body { background-color: #0b0f0c !important; }
  .email-card { background-color: #121814 !important; border-color: #243028 !important; }
  .email-header { background-color: #1a2a12 !important; border-color: #243028 !important; }
  .email-title { color: #f3f7f0 !important; }
  .email-text { color: #c6d2c4 !important; }
  .email-muted { color: #93a094 !important; }
  .email-meta { background-color: #0f1511 !important; border-color: #2a362e !important; }
  .email-meta-label { color: #93a094 !important; }
  .email-meta-value { color: #f3f7f0 !important; }
  .email-brand { color: #f3f7f0 !important; }
  .email-tag { color: #93a094 !important; }
  .email-footer { color: #6f7d72 !important; }
  .email-link { color: #9ae63b !important; }
  .email-btn-secondary {
    background-color: #121814 !important;
    border-color: #243028 !important;
    color: #f3f7f0 !important;
  }
  .email-note-info { background-color: #0f1b2a !important; border-color: #1e3a5f !important; color: #93c5fd !important; }
  .email-note-success { background-color: #10261a !important; border-color: #1f4a32 !important; color: #6ee7a8 !important; }
  .email-note-warning { background-color: #2a210c !important; border-color: #5a4414 !important; color: #fbbf24 !important; }
  .email-note-danger { background-color: #2a1212 !important; border-color: #5a2424 !important; color: #fca5a5 !important; }
}
