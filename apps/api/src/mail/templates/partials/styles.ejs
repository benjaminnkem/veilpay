:root {
  color-scheme: light dark;
  --bg: #f4f6f2;
  --bg-accent: #e8f0d8;
  --card: #ffffff;
  --card-border: #e2e8d8;
  --ink: #142016;
  --ink-soft: #3d4a3f;
  --muted: #6b786f;
  --muted-2: #8a968c;
  --line: #e6ebe0;
  --surface: #f7faf3;
  --surface-border: #e0e8d4;
  --brand: #6fbf1f;
  --brand-strong: #4f9a0d;
  --brand-soft: #eef8d9;
  --brand-ink: #2f5a08;
  --btn-bg: #6fbf1f;
  --btn-ink: #142016;
  --btn-shadow: 0 8px 20px rgba(111, 191, 31, 0.28);
  --success: #16803c;
  --success-bg: #e8f8ee;
  --success-border: #b7e4c7;
  --warning: #a16207;
  --warning-bg: #fff8e8;
  --warning-border: #f0d48a;
  --danger: #b42318;
  --danger-bg: #fef3f2;
  --danger-border: #fecdca;
  --info: #175cd3;
  --info-bg: #eff8ff;
  --info-border: #b2ddff;
  --shadow: 0 18px 50px rgba(20, 32, 22, 0.08);
}

@media (prefers-color-scheme: dark) {
  :root {
    --bg: #0b0f0c;
    --bg-accent: #142016;
    --card: #121814;
    --card-border: #243028;
    --ink: #f3f7f0;
    --ink-soft: #c6d2c4;
    --muted: #93a094;
    --muted-2: #6f7d72;
    --line: #243028;
    --surface: #0f1511;
    --surface-border: #2a362e;
    --brand: #9ae63b;
    --brand-strong: #b8f25d;
    --brand-soft: #1a2a12;
    --brand-ink: #d8f7a8;
    --btn-bg: #9ae63b;
    --btn-ink: #0f160c;
    --btn-shadow: 0 10px 28px rgba(154, 230, 59, 0.18);
    --success: #6ee7a8;
    --success-bg: #10261a;
    --success-border: #1f4a32;
    --warning: #fbbf24;
    --warning-bg: #2a210c;
    --warning-border: #5a4414;
    --danger: #fca5a5;
    --danger-bg: #2a1212;
    --danger-border: #5a2424;
    --info: #93c5fd;
    --info-bg: #0f1b2a;
    --info-border: #1e3a5f;
    --shadow: 0 22px 60px rgba(0, 0, 0, 0.45);
  }
}

html,
body {
  margin: 0 !important;
  padding: 0 !important;
  width: 100% !important;
  background: var(--bg) !important;
  color: var(--ink);
  font-family:
    Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto,
    Helvetica, Arial, sans-serif;
  line-height: 1.55;
  -webkit-text-size-adjust: 100%;
}

body {
  padding: 0;
}

table {
  border-collapse: collapse;
  border-spacing: 0;
}

img {
  border: 0;
  outline: none;
  text-decoration: none;
  display: block;
}

a {
  color: var(--brand-strong);
  text-decoration: none;
}

.wrapper {
  width: 100%;
  background:
    radial-gradient(1200px 400px at 50% -80px, var(--bg-accent), transparent 60%),
    var(--bg);
  padding: 40px 16px;
}

.shell {
  width: 100%;
  max-width: 600px;
  margin: 0 auto;
}

.card {
  background: var(--card);
  border: 1px solid var(--card-border);
  border-radius: 18px;
  overflow: hidden;
  box-shadow: var(--shadow);
}

.header {
  padding: 22px 28px;
  border-bottom: 1px solid var(--line);
  background: linear-gradient(180deg, var(--brand-soft), transparent);
}

.brand-row {
  width: 100%;
}

.brand-mark {
  width: 36px;
  height: 36px;
  border-radius: 10px;
  background: linear-gradient(145deg, var(--brand), var(--brand-strong));
  color: var(--btn-ink);
  font-size: 15px;
  font-weight: 800;
  letter-spacing: -0.02em;
  text-align: center;
  line-height: 36px;
}

.brand-text {
  padding-left: 12px;
}

.brand-name {
  font-size: 16px;
  font-weight: 700;
  letter-spacing: -0.02em;
  color: var(--ink);
  line-height: 1.2;
}

.brand-tag {
  font-size: 11px;
  color: var(--muted);
  letter-spacing: 0.04em;
  text-transform: uppercase;
  font-weight: 600;
}

.content {
  padding: 28px;
}

.eyebrow {
  display: inline-block;
  margin: 0 0 12px;
  padding: 4px 10px;
  border-radius: 999px;
  background: var(--brand-soft);
  color: var(--brand-ink);
  border: 1px solid color-mix(in srgb, var(--brand) 28%, transparent);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

h1 {
  margin: 0 0 12px;
  font-size: 24px;
  line-height: 1.25;
  letter-spacing: -0.03em;
  color: var(--ink);
  font-weight: 700;
}

p {
  margin: 0 0 14px;
  color: var(--ink-soft);
  font-size: 15px;
}

.lead {
  font-size: 15.5px;
  color: var(--ink-soft);
}

.meta {
  margin: 18px 0 20px;
  padding: 0;
  background: var(--surface);
  border: 1px solid var(--surface-border);
  border-radius: 12px;
  overflow: hidden;
}

.meta-row {
  padding: 12px 14px;
  border-bottom: 1px solid var(--surface-border);
  font-size: 14px;
  color: var(--ink-soft);
}

.meta-row:last-child {
  border-bottom: 0;
}

.meta-label {
  display: block;
  margin-bottom: 2px;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: var(--muted);
}

.meta-value {
  color: var(--ink);
  font-weight: 600;
}

.btn-wrap {
  margin: 8px 0 18px;
}

.btn {
  display: inline-block;
  padding: 13px 20px;
  background: linear-gradient(180deg, var(--brand), var(--brand-strong));
  color: var(--btn-ink) !important;
  text-decoration: none !important;
  border-radius: 10px;
  font-weight: 700;
  font-size: 14px;
  letter-spacing: -0.01em;
  box-shadow: var(--btn-shadow);
  border: 1px solid color-mix(in srgb, var(--brand-strong) 40%, transparent);
}

.btn-secondary {
  display: inline-block;
  padding: 12px 18px;
  background: transparent;
  color: var(--ink) !important;
  text-decoration: none !important;
  border-radius: 10px;
  font-weight: 600;
  font-size: 14px;
  border: 1px solid var(--line);
}

.muted {
  color: var(--muted) !important;
  font-size: 13px;
}

.muted a {
  color: var(--brand-strong);
  word-break: break-all;
}

.note {
  margin: 16px 0;
  padding: 12px 14px;
  border-radius: 10px;
  font-size: 13px;
  line-height: 1.5;
}

.note-info {
  background: var(--info-bg);
  border: 1px solid var(--info-border);
  color: var(--info);
}

.note-success {
  background: var(--success-bg);
  border: 1px solid var(--success-border);
  color: var(--success);
}

.note-warning {
  background: var(--warning-bg);
  border: 1px solid var(--warning-border);
  color: var(--warning);
}

.note-danger {
  background: var(--danger-bg);
  border: 1px solid var(--danger-border);
  color: var(--danger);
}

.footer {
  padding: 0 8px;
  margin-top: 18px;
  text-align: center;
  color: var(--muted-2);
  font-size: 12px;
  line-height: 1.5;
}

.footer a {
  color: var(--muted);
  text-decoration: underline;
  text-underline-offset: 2px;
}

.divider {
  height: 1px;
  background: var(--line);
  margin: 20px 0;
  border: 0;
}

.stack {
  margin: 0;
  padding-left: 18px;
  color: var(--ink-soft);
  font-size: 14px;
}

.stack li {
  margin-bottom: 6px;
}

@media only screen and (max-width: 620px) {
  .wrapper {
    padding: 20px 10px;
  }

  .content,
  .header {
    padding-left: 20px;
    padding-right: 20px;
  }

  h1 {
    font-size: 22px;
  }
}
