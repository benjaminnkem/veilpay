<%# Expects: rows = [{ label, value }] %>
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" class="email-meta"
       style="border-collapse:collapse;width:100%;margin:18px 0 22px 0;background-color:#f7faf3;border:1px solid #e0e8d4;border-radius:12px;overflow:hidden;">
  <% rows.forEach(function (row, index) { %>
    <tr>
      <td style="padding:12px 14px;<%= index < rows.length - 1 ? 'border-bottom:1px solid #e0e8d4;' : '' %>">
        <div class="email-meta-label" style="font-family:Arial,Helvetica,sans-serif;font-size:11px;font-weight:700;letter-spacing:0.5px;text-transform:uppercase;color:#6b786f;line-height:1.3;margin:0 0 3px 0;">
          <%= row.label %>
        </div>
        <div class="email-meta-value" style="font-family:Arial,Helvetica,sans-serif;font-size:14px;font-weight:600;color:#142016;line-height:1.4;margin:0;word-break:break-word;">
          <%= row.value %>
        </div>
      </td>
    </tr>
  <% }) %>
</table>
