<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Welcome to <%= appName %></title>
  <style><%- include('partials/styles') %></style>
</head>
<body>
  <div class="wrapper">
    <div class="card">
      <div class="header">
        <div class="brand"><%= appName %></div>
      </div>
      <div class="content">
        <h1>Welcome, <%= firstName %></h1>
        <p>
          Your organization <strong><%= organizationName %></strong> is ready on <%= appName %>.
          Manage employees, compensation, payroll cycles, and approvals from one confidential workspace.
        </p>
        <p>
          <a class="btn" href="<%= dashboardUrl %>">Open dashboard</a>
        </p>
        <p class="muted">
          Or sign in anytime at <a href="<%= loginUrl %>"><%= loginUrl %></a>
        </p>
      </div>
      <div class="footer">
        © <%= year %> <%= appName %>. Confidential payroll infrastructure.
      </div>
    </div>
  </div>
</body>
</html>
