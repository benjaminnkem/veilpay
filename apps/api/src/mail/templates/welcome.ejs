<%- include('partials/layout-start', { title: 'Welcome to ' + appName }) %>

<span class="eyebrow">Welcome</span>
<h1>Your workspace is ready, <%= firstName %></h1>
<p class="lead">
  <strong><%= organizationName %></strong> is set up on <%= appName %>.
  Hire people, define compensation, run payroll, and move approvals from one
  confidential control plane.
</p>

<div class="meta">
  <div class="meta-row">
    <span class="meta-label">Organization</span>
    <span class="meta-value"><%= organizationName %></span>
  </div>
  <div class="meta-row">
    <span class="meta-label">Next step</span>
    <span class="meta-value">Open the dashboard and invite your team</span>
  </div>
</div>

<div class="btn-wrap">
  <a class="btn" href="<%= dashboardUrl %>">Open dashboard</a>
</div>

<p class="muted">
  Prefer the sign-in page?
  <a href="<%= loginUrl %>"><%= loginUrl %></a>
</p>

<%- include('partials/layout-end') %>
