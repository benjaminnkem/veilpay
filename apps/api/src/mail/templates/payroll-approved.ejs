<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Payroll approved</title>
  <style><%- include('partials/styles') %></style>
</head>
<body>
  <div class="wrapper">
    <div class="card">
      <div class="header">
        <div class="brand"><%= appName %></div>
      </div>
      <div class="content">
        <h1>Payroll fully approved</h1>
        <p>Hi <%= firstName %>,</p>
        <p>
          <strong><%= payrollName %></strong> completed the approval chain and is ready for execution.
        </p>
        <p>
          <a class="btn" href="<%= payrollUrl %>">Open payroll</a>
        </p>
      </div>
      <div class="footer">
        © <%= year %> <%= appName %>.
      </div>
    </div>
  </div>
</body>
</html>
