<%- include('partials/layout-start', { title: 'Payroll approved' }) %>

<span class="eyebrow">Payroll</span>
<h1>Payroll fully approved</h1>
<p class="lead">Hi <%= firstName %>,</p>
<p>
  <strong><%= payrollName %></strong> completed every approval step and is ready
  for execution.
</p>

<div class="note note-success">
  Ready for execution. Open the run to launch payment processing when your treasury flow is prepared.
</div>

<div class="meta">
  <div class="meta-row">
    <span class="meta-label">Payroll run</span>
    <span class="meta-value"><%= payrollName %></span>
  </div>
  <div class="meta-row">
    <span class="meta-label">Status</span>
    <span class="meta-value">Approved</span>
  </div>
</div>

<div class="btn-wrap">
  <a class="btn" href="<%= payrollUrl %>">Open payroll</a>
</div>

<%- include('partials/layout-end') %>
