<%- include('partials/layout-start', { title: 'Reset your password' }) %>

<span class="eyebrow">Security</span>
<h1>Reset your password</h1>
<p class="lead">Hi <%= firstName %>,</p>
<p>
  We received a request to reset the password for your <%= appName %> account.
  This link expires in <strong><%= expiresInHours %> hour(s)</strong>.
</p>

<div class="btn-wrap">
  <a class="btn" href="<%= resetUrl %>">Reset password</a>
</div>

<div class="note note-warning">
  If you did not request a reset, ignore this email. Your password will stay the same.
</div>

<p class="muted">
  Or paste this link into your browser:<br />
  <a href="<%= resetUrl %>"><%= resetUrl %></a>
</p>

<%- include('partials/layout-end') %>
