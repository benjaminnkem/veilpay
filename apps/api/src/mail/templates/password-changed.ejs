<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Password changed</title>
  <style><%- include('partials/styles') %></style>
</head>
<body>
  <div class="wrapper">
    <div class="card">
      <div class="header">
        <div class="brand"><%= appName %></div>
      </div>
      <div class="content">
        <h1>Password updated</h1>
        <p>Hi <%= firstName %>,</p>
        <p>
          Your <%= appName %> password was changed successfully. All existing sessions have been signed out.
        </p>
        <p>
          If you did not make this change, sign in and update your password immediately, or contact your organization owner.
        </p>
        <p>
          <a class="btn" href="<%= loginUrl %>">Sign in</a>
        </p>
      </div>
      <div class="footer">
        © <%= year %> <%= appName %>.
      </div>
    </div>
  </div>
</body>
</html>
