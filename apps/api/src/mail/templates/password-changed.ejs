<%- include('partials/layout-start', { title: 'Password updated' }) %>

<span class="eyebrow">Security</span>
<h1>Your password was updated</h1>
<p class="lead">Hi <%= firstName %>,</p>
<p>
  The password for your <%= appName %> account was changed successfully.
  Existing sessions were signed out for your protection.
</p>

<div class="note note-success">
  If this was you, no further action is required.
</div>

<div class="note note-danger">
  If you did not make this change, reset your password immediately and contact your organization owner.
</div>

<div class="btn-wrap">
  <a class="btn" href="<%= loginUrl %>">Sign in</a>
</div>

<%- include('partials/layout-end') %>
