<%- include('partials/layout-start', {
  title: 'Password updated',
  preheader: 'Your ' + appName + ' password was changed successfully.'
}) %>

<%- include('partials/eyebrow', { label: 'Security' }) %>

<h1 class="email-title" style="margin:0 0 12px 0;font-family:Arial,Helvetica,sans-serif;font-size:24px;line-height:1.25;font-weight:700;color:#142016;letter-spacing:-0.3px;">
  Your password was updated
</h1>

<p class="email-text" style="margin:0 0 14px 0;font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:1.55;color:#3d4a3f;">
  Hi <%= firstName %>,
</p>

<p class="email-text" style="margin:0 0 14px 0;font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:1.55;color:#3d4a3f;">
  The password for your <%= appName %> account was changed successfully.
  Existing sessions were signed out for your protection.
</p>

<%- include('partials/note', {
  type: 'success',
  text: 'If this was you, no further action is required.'
}) %>

<%- include('partials/note', {
  type: 'danger',
  text: 'If you did not make this change, reset your password immediately and contact your organization owner.'
}) %>

<table role="presentation" cellspacing="0" cellpadding="0" border="0" style="border-collapse:collapse;margin:0 0 20px 0;">
  <tr>
    <td style="padding:0;">
      <%- include('partials/button', { href: loginUrl, label: 'Sign in' }) %>
    </td>
  </tr>
</table>

<%- include('partials/layout-end') %>
