<%- include('partials/layout-start', { title: 'Invitation accepted' }) %>

<span class="eyebrow">Team update</span>
<h1><%= inviteeName %> accepted your invite</h1>
<p class="lead">Hi <%= inviterFirstName %>,</p>
<p>
  A new teammate is ready in <strong><%= organizationName %></strong>.
  Their account is active and they can sign in to <%= appName %>.
</p>

<div class="meta">
  <div class="meta-row">
    <span class="meta-label">Name</span>
    <span class="meta-value"><%= inviteeName %></span>
  </div>
  <div class="meta-row">
    <span class="meta-label">Email</span>
    <span class="meta-value"><%= inviteeEmail %></span>
  </div>
  <div class="meta-row">
    <span class="meta-label">Role</span>
    <span class="meta-value"><%= role %></span>
  </div>
</div>

<div class="btn-wrap">
  <a class="btn" href="<%= employeesUrl %>">View team</a>
</div>

<%- include('partials/layout-end') %>
