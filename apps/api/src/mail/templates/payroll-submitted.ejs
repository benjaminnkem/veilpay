<%- include('partials/layout-start', { title: 'Payroll submitted' }) %>

<span class="eyebrow">Payroll</span>
<h1>Payroll submitted for approval</h1>
<p class="lead">Hi <%= firstName %>,</p>
<p>
  <strong><%= payrollName %></strong> was submitted and is now moving through
  your approval sequence.
</p>

<div class="meta">
  <div class="meta-row">
    <span class="meta-label">Payroll run</span>
    <span class="meta-value"><%= payrollName %></span>
  </div>
  <div class="meta-row">
    <span class="meta-label">Employees included</span>
    <span class="meta-value"><%= employeeCount %></span>
  </div>
  <div class="meta-row">
    <span class="meta-label">Status</span>
    <span class="meta-value">Pending approval</span>
  </div>
</div>

<div class="btn-wrap">
  <a class="btn" href="<%= payrollUrl %>">Review payroll</a>
</div>

<p class="muted">
  Approvers will be notified in sequence (HR, Finance, CEO by default).
</p>

<%- include('partials/layout-end') %>
