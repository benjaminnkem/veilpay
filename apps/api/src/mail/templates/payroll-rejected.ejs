<%- include('partials/layout-start', { title: 'Payroll rejected' }) %>

<span class="eyebrow">Payroll</span>
<h1>Payroll needs attention</h1>
<p class="lead">Hi <%= firstName %>,</p>
<p>
  <strong><%= payrollName %></strong> was rejected at the
  <strong><%= level %></strong> approval step.
</p>

<div class="note note-danger">
  The run was marked rejected. Review comments, update the draft if needed, and resubmit.
</div>

<div class="meta">
  <div class="meta-row">
    <span class="meta-label">Payroll run</span>
    <span class="meta-value"><%= payrollName %></span>
  </div>
  <div class="meta-row">
    <span class="meta-label">Rejected at</span>
    <span class="meta-value"><%= level %></span>
  </div>
  <% if (comments) { %>
    <div class="meta-row">
      <span class="meta-label">Comments</span>
      <span class="meta-value"><%= comments %></span>
    </div>
  <% } %>
</div>

<div class="btn-wrap">
  <a class="btn" href="<%= payrollUrl %>">Review payroll</a>
</div>

<%- include('partials/layout-end') %>
